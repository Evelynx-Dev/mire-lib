extern fn rt_dicts_len: (dict :&dict) :i64 lib "c"
extern fn rt_dicts_keys: (dict :&dict) :vec[str] lib "c"
extern fn rt_dicts_values: (dict :&dict) :vec[i64] lib "c"
extern fn rt_dicts_has: (dict :&dict, key :str) :bool lib "c"
extern fn rt_dicts_get: (dict :&dict, key :str) :str lib "c"
extern fn rt_dicts_get_i64: (dict :&dict, key :str) :i64 lib "c"
extern fn rt_dicts_set: (dict, key :str, value) lib "c"
extern fn rt_dicts_remove: (dict, key :str) lib "c"
extern fn rt_dicts_entries: (dict :&dict) :i64 lib "c"
extern fn rt_dicts_merge: (dict, other) lib "c"

pub fn len: (m :&dict) :i64 { return rt_dicts_len(m) }
pub fn keys: (m :&dict) :vec[str] { return rt_dicts_keys(m) }
pub fn values: (m :&dict) :vec[i64] { return rt_dicts_values(m) }
pub fn has: (m :&dict, key :str) :bool { return rt_dicts_has(m, key) }
pub fn get: (m :&dict, key :str) :str { return rt_dicts_get(m, key) }
pub fn get_i64: (m :&dict, key :str) :i64 { return rt_dicts_get_i64(m, key) }
pub fn set: (m :dict, key :str, value) { rt_dicts_set(m, key, value) }
pub fn remove: (m :dict, key :str) { rt_dicts_remove(m, key) }
pub fn count: (m :&dict) :i64 { return rt_dicts_entries(m) }
pub fn merge: (m :dict, other) { rt_dicts_merge(m, other) }
