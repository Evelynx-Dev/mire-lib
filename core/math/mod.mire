module math

// ── Constants ──────────────────────────────────────────────────────
extern fn rt_math_pi: () :f64 lib "c"
extern fn rt_math_e: () :f64 lib "c"
extern fn rt_math_tau: () :f64 lib "c"

// ── Trigonometry ───────────────────────────────────────────────────
extern fn rt_math_sin: (value :f64) :f64 lib "c"
extern fn rt_math_cos: (value :f64) :f64 lib "c"
extern fn rt_math_tan: (value :f64) :f64 lib "c"
extern fn rt_math_asin: (value :f64) :f64 lib "c"
extern fn rt_math_acos: (value :f64) :f64 lib "c"
extern fn rt_math_atan2: (y :f64, x :f64) :f64 lib "c"

// ── Power / Log / Exp ──────────────────────────────────────────────
extern fn rt_math_pow: (base :f64, exponent :f64) :f64 lib "c"
extern fn rt_math_sqrt: (value :f64) :f64 lib "c"
extern fn rt_math_log: (value :f64) :f64 lib "c"
extern fn rt_math_log10: (value :f64) :f64 lib "c"
extern fn rt_math_exp: (value :f64) :f64 lib "c"

// ── Rounding ───────────────────────────────────────────────────────
extern fn rt_math_round: (value :f64) :i64 lib "c"
extern fn rt_math_floor: (value :f64) :i64 lib "c"
extern fn rt_math_ceil: (value :f64) :i64 lib "c"

// ── Aggregate (on vec[i64]) ───────────────────────────────────────
extern fn rt_math_sum_i64: (list :&vec[i64]) :i64 lib "c"
extern fn rt_math_min_list_i64: (list :&vec[i64]) :i64 lib "c"
extern fn rt_math_max_list_i64: (list :&vec[i64]) :i64 lib "c"
extern fn rt_math_mean_i64: (list :&vec[i64]) :f64 lib "c"
extern fn rt_math_variance_i64: (list :&vec[i64]) :f64 lib "c"
extern fn rt_math_stddev_i64: (list :&vec[i64]) :f64 lib "c"
extern fn rt_math_median_i64: (list :&vec[i64]) :f64 lib "c"

// ── Range ──────────────────────────────────────────────────────────
extern fn rt_math_range_i64: (end :i64) :vec[i64] lib "c"
extern fn rt_math_range_between_i64: (start :i64, end :i64) :vec[i64] lib "c"
extern fn rt_math_range_step_i64: (start :i64, end :i64, step :i64) :vec[i64] lib "c"

// ── Random ─────────────────────────────────────────────────────────
extern fn rt_math_random_seed: (seed :i64) lib "c"
extern fn rt_math_random_i64: () :i64 lib "c"
extern fn rt_math_random_f64: () :f64 lib "c"
extern fn rt_math_random_bool: () :i64 lib "c"
extern fn rt_math_random_range_i64: (min :i64, max :i64) :i64 lib "c"

// ── Public API: Constants ──────────────────────────────────────────
pub fn pi: () :f64 { return rt_math_pi() }
pub fn e: () :f64 { return rt_math_e() }
pub fn tau: () :f64 { return rt_math_tau() }

// ── Public API: Trigonometry ───────────────────────────────────────
pub fn sin: (v :f64) :f64 { return rt_math_sin(v) }
pub fn cos: (v :f64) :f64 { return rt_math_cos(v) }
pub fn tan: (v :f64) :f64 { return rt_math_tan(v) }
pub fn asin: (v :f64) :f64 { return rt_math_asin(v) }
pub fn acos: (v :f64) :f64 { return rt_math_acos(v) }
pub fn atan2: (y :f64, x :f64) :f64 { return rt_math_atan2(y, x) }

// ── Public API: Power / Log ────────────────────────────────────────
pub fn pow: (base :f64, exp :f64) :f64 { return rt_math_pow(base, exp) }
pub fn sqrt: (v :f64) :f64 { return rt_math_sqrt(v) }
pub fn log: (v :f64) :f64 { return rt_math_log(v) }
pub fn log10: (v :f64) :f64 { return rt_math_log10(v) }
pub fn exp: (v :f64) :f64 { return rt_math_exp(v) }

// ── Public API: Rounding ───────────────────────────────────────────
pub fn round: (v :f64) :i64 { return rt_math_round(v) }
pub fn floor: (v :f64) :i64 { return rt_math_floor(v) }
pub fn ceil: (v :f64) :i64 { return rt_math_ceil(v) }

// ── Public API: Aggregate ──────────────────────────────────────────
pub fn sum: (v :&vec[i64]) :i64 { return rt_math_sum_i64(v) }
pub fn min: (v :&vec[i64]) :i64 { return rt_math_min_list_i64(v) }
pub fn max: (v :&vec[i64]) :i64 { return rt_math_max_list_i64(v) }
pub fn mean: (v :&vec[i64]) :f64 { return rt_math_mean_i64(v) }
pub fn variance: (v :&vec[i64]) :f64 { return rt_math_variance_i64(v) }
pub fn stddev: (v :&vec[i64]) :f64 { return rt_math_stddev_i64(v) }
pub fn median: (v :&vec[i64]) :f64 { return rt_math_median_i64(v) }

// ── Public API: Range ──────────────────────────────────────────────
pub fn range: (end :i64) :vec[i64] { return rt_math_range_i64(end) }
pub fn range_between: (start :i64, end :i64) :vec[i64] { return rt_math_range_between_i64(start, end) }
pub fn range_step: (start :i64, end :i64, step :i64) :vec[i64] { return rt_math_range_step_i64(start, end, step) }

// ── Public API: Random ─────────────────────────────────────────────
pub fn random_seed: (seed :i64) { rt_math_random_seed(seed) }
pub fn random: () :i64 { return rt_math_random_i64() }
pub fn random_f64: () :f64 { return rt_math_random_f64() }
pub fn random_bool: () :i64 { return rt_math_random_bool() }
pub fn random_range: (min :i64, max :i64) :i64 { return rt_math_random_range_i64(min, max) }
