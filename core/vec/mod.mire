module vec

extern fn rt_vecs_len: (list :&anything) :i64 lib "c"
extern fn rt_vecs_push_i64: (list :vec[i64], value :i64) :vec[i64] lib "c"
extern fn rt_vecs_push_ptr: (list :vec[str], value :str) :vec[str] lib "c"
extern fn rt_vecs_pop: (list :&vec[i64]) :i64 lib "c"
extern fn rt_vecs_get_i64: (list :&vec[i64], index :i64) :i64 lib "c"
extern fn rt_vecs_get_ptr: (list :vec[str], index :i64) :str lib "c"
extern fn rt_vecs_first: (list :&vec[i64], line :i64, col :i64, file :str) :i64 lib "c"
extern fn rt_vecs_last: (list :&vec[i64], line :i64, col :i64, file :str) :i64 lib "c"
extern fn rt_vecs_remove: (list :&vec[i64], index :i64) lib "c"
extern fn rt_vecs_clear: (list :&vec[i64]) lib "c"
extern fn rt_vecs_sort: (list :&vec[i64]) lib "c"
extern fn rt_vecs_reverse: (list :&vec[i64]) :vec[i64] lib "c"
extern fn rt_vecs_unique: (list :&vec[i64]) :vec[i64] lib "c"
extern fn rt_vecs_contains_i64: (list :&vec[i64], value :i64) :bool lib "c"
extern fn rt_vecs_index_of_i64: (list :&vec[i64], value :i64) :i64 lib "c"
extern fn rt_vecs_slice: (list :&vec[i64], start :i64, end :i64) :vec[i64] lib "c"
extern fn rt_vecs_flatten: (list :&vec[i64]) :vec[i64] lib "c"
extern fn rt_vecs_concat: (list :&vec[i64], other :&vec[i64]) lib "c"
extern fn rt_lists_join_list: (list :vec[str], sep :&str) :str lib "c"

pub fn len: (v :&anything) :i64 { return rt_vecs_len(v) }
pub fn push::i64: (v :vec[i64], value :i64) :vec[i64] { return rt_vecs_push_i64(v, value) }
pub fn push::str: (v :vec[str], value :str) :vec[str] { return rt_vecs_push_ptr(v, value) }
pub fn pop::i64: (v :&vec[i64]) :i64 { return rt_vecs_pop(v) }
pub fn get::i64: (v :&vec[i64], index :i64) :i64 { return rt_vecs_get_i64(v, index) }
pub fn get::str: (v :vec[str], index :i64) :str { return rt_vecs_get_ptr(v, index) }
pub fn first::i64: (v :&vec[i64]) :i64 { return rt_vecs_first(v, 0, 0, "") }
pub fn last::i64: (v :&vec[i64]) :i64 { return rt_vecs_last(v, 0, 0, "") }
pub fn remove: (v :&vec[i64], index :i64) { rt_vecs_remove(v, index) }
pub fn clear: (v :&vec[i64]) { rt_vecs_clear(v) }
pub fn sort: (v :&vec[i64]) { rt_vecs_sort(v) }
pub fn reverse: (v :&vec[i64]) :vec[i64] { return rt_vecs_reverse(v) }
pub fn unique: (v :&vec[i64]) :vec[i64] { return rt_vecs_unique(v) }
pub fn contains::i64: (v :&vec[i64], value :i64) :bool { return rt_vecs_contains_i64(v, value) }
pub fn index::i64: (v :&vec[i64], value :i64) :i64 { return rt_vecs_index_of_i64(v, value) }
pub fn slice: (v :&vec[i64], start :i64, end :i64) :vec[i64] { return rt_vecs_slice(v, start, end) }
pub fn flatten: (v :&vec[i64]) :vec[i64] { return rt_vecs_flatten(v) }
pub fn concat: (v :&vec[i64], other :&vec[i64]) { rt_vecs_concat(v, other) }
pub fn join: (v :vec[str], sep :&str) :str { return rt_lists_join_list(v, sep) }
