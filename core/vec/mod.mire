module vec

// ── Core length (works on any vec type) ────────────────────────────
extern fn rt_lists_len: (list :&anything) :i64 lib "c"
extern fn rt_vec_len: (list :&anything) :i64 lib "c"

// ── Push i64 ──────────────────────────────────────────────────────
extern fn rt_lists_push_i64: (list :vec[i64], value :i64) :vec[i64] lib "c"

// ── Pop ────────────────────────────────────────────────────────────
extern fn rt_lists_pop: (list :&vec[i64]) :i64 lib "c"

// ── Get/Set (type-specific) ────────────────────────────────────────
extern fn rt_lists_get_i64: (list :&vec[i64], index :i64) :i64 lib "c"
extern fn rt_vec_get_str: (list :&vec[str], index :i64) :str lib "c"
extern fn rt_lists_set_i64: (list :&vec[i64], index :i64, value :i64) lib "c"

// ── Remove / Clear ─────────────────────────────────────────────────
extern fn rt_lists_remove: (list :&vec[i64], index :i64) lib "c"
extern fn rt_lists_clear: (list :&vec[i64]) lib "c"

// ── Sort / Reverse / Unique ────────────────────────────────────────
extern fn rt_lists_sort: (list :&vec[i64]) lib "c"
extern fn rt_lists_reverse: (list :&vec[i64]) :vec[i64] lib "c"
extern fn rt_lists_unique: (list :&vec[i64]) :vec[i64] lib "c"

// ── Contains / IndexOf ─────────────────────────────────────────────
extern fn rt_lists_contains_i64: (list :&vec[i64], value :i64) :bool lib "c"
extern fn rt_lists_index_of_i64: (list :&vec[i64], value :i64) :i64 lib "c"

// ── Slice / Flatten / Concat ───────────────────────────────────────
extern fn rt_lists_slice: (list :&vec[i64], start :i64, end :i64) :vec[i64] lib "c"
extern fn rt_lists_flatten: (list :&vec[i64]) :vec[i64] lib "c"
extern fn rt_lists_concat: (list :&vec[i64], other :&vec[i64]) lib "c"

// ── First / Last ───────────────────────────────────────────────────
extern fn rt_lists_first: (list :&vec[i64]) :i64 lib "c"
extern fn rt_lists_last: (list :&vec[i64]) :i64 lib "c"

// ── Join (vec of str) ──────────────────────────────────────────────
extern fn rt_lists_join_list: (list :&vec[str], sep :&str) :str lib "c"

// ── Public API: len ───────────────────────────────────────────────
pub fn len: (v :&anything) :i64 { return rt_lists_len(v) }

// ── Public API: push_i64 ──────────────────────────────────────────
pub fn push_i64: (v :vec[i64], value :i64) :vec[i64] { return rt_lists_push_i64(v, value) }

// ── Public API: pop ────────────────────────────────────────────────
pub fn pop: (v :&vec[i64]) :i64 { return rt_lists_pop(v) }

// ── Public API: get_i64 / get_str ─────────────────────────────────
pub fn get_i64: (v :&vec[i64], index :i64) :i64 { return rt_lists_get_i64(v, index) }
pub fn get_str: (v :&vec[str], index :i64) :str { return rt_vec_get_str(v, index) }

// ── Public API: set_i64 ───────────────────────────────────────────
pub fn set_i64: (v :&vec[i64], index :i64, value :i64) { rt_lists_set_i64(v, index, value) }

// ── Public API: remove / clear ─────────────────────────────────────
pub fn remove: (v :&vec[i64], index :i64) { rt_lists_remove(v, index) }
pub fn clear: (v :&vec[i64]) { rt_lists_clear(v) }

// ── Public API: sort / reverse / unique ────────────────────────────
pub fn sort: (v :&vec[i64]) { rt_lists_sort(v) }
pub fn reverse: (v :&vec[i64]) :vec[i64] { return rt_lists_reverse(v) }
pub fn unique: (v :&vec[i64]) :vec[i64] { return rt_lists_unique(v) }

// ── Public API: contains / index ───────────────────────────────────
pub fn contains: (v :&vec[i64], value :i64) :bool { return rt_lists_contains_i64(v, value) }
pub fn index: (v :&vec[i64], value :i64) :i64 { return rt_lists_index_of_i64(v, value) }

// ── Public API: slice / flatten / concat ───────────────────────────
pub fn slice: (v :&vec[i64], start :i64, end :i64) :vec[i64] { return rt_lists_slice(v, start, end) }
pub fn flatten: (v :&vec[i64]) :vec[i64] { return rt_lists_flatten(v) }
pub fn concat: (v :&vec[i64], other :&vec[i64]) { rt_lists_concat(v, other) }

// ── Public API: first / last ──────────────────────────────────────
pub fn first: (v :&vec[i64]) :i64 { return rt_lists_first(v) }
pub fn last: (v :&vec[i64]) :i64 { return rt_lists_last(v) }

// ── Public API: join ───────────────────────────────────────────────
pub fn join: (v :&vec[str], sep :&str) :str { return rt_lists_join_list(v, sep) }
