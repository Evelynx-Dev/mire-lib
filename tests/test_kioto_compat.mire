load kioto

@[test]
pub fn test_vec: () :bool {
    set v = [] :vec[i64] mut
    set v = lists::push(v 10)
    set v = lists::push(v 20)
    set v = lists::push(v 30)
    set n = lists::len(v)
    return n == 3
}

@[test]
pub fn test_str: () :bool {
    set s = "hello world"
    set l = strings::len(s)
    return l == 11
}
